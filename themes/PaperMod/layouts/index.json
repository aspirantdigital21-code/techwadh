{{- $index := slice -}}
{{- range where site.RegularPages "Section" "posts" -}}
    {{- if and (not .Params.searchHidden) (ne .Layout `archives`) (ne .Layout `search`) }}
    {{- $index = $index | append (dict "title" .Title "content" .Plain "permalink" .Permalink "summary" .Summary "keywords" .Keywords) -}}
    {{- end }}
{{- end -}}
{{- $index | jsonify -}}
